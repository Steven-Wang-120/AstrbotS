# Guardian 宿主看门狗 —— 环境变量清单（Linux / Windows 共用）
#
# 正常情况下你**不需要手改这个文件**：`install-watchdog.sh` /
# `install-watchdog.ps1` 会探测真实的 compose 目录与容器名，生成一份
# `guardian-watchdog.env`（Linux 落在 /etc/guardian/，Windows 落在脚本同目录）。
# 本文件只用于两种情况：手工部署，或者安装后需要覆盖个别项。
#
# 复制为 guardian-watchdog.env 后按实际环境改。

# --------------------------------------------------------------------- #
# 1. 路径（最容易配错的一组）
# --------------------------------------------------------------------- #
# 含 compose.yml 的目录（`docker compose` 的 --project-directory）。
GUARDIAN_COMPOSE_DIR=/opt/astrbot-stack

# 宿主机侧的 ./data 目录，也就是容器内 /AstrBot/data 的落点。
# 插件把请求写到容器内 /AstrBot/data/guardian/restart_request.json，
# 映射到宿主就是 <GUARDIAN_DATA_ROOT>/guardian/restart_request.json。
# 少写一层会导致请求写出去无人消费，而且失败是静默的。
GUARDIAN_DATA_ROOT=/opt/astrbot-stack/data

# 下面四项留空即按 GUARDIAN_DATA_ROOT 推断，一般不用填。
# GUARDIAN_REQUEST_FILE=
# GUARDIAN_RESULT_FILE=
# GUARDIAN_LOG_FILE=/var/log/guardian-watchdog.log
# Windows 下日志建议改到 C:\ProgramData\guardian\guardian-watchdog.log

# --------------------------------------------------------------------- #
# 2. 允许被停止/重启的容器
# --------------------------------------------------------------------- #
# 空格或逗号分隔。安装脚本会用 `docker compose ps --format json` 的真实容器名
# 自动填充，名字对不上会被看门狗拒绝（target-not-allowed）。
# 允许的最大数量是 10 个。
GUARDIAN_ALLOWED_TARGETS=astrbot napcat

# --------------------------------------------------------------------- #
# 3. 执行后端
# --------------------------------------------------------------------- #
# compose  -> 走 `docker compose --project-directory <dir> stop|restart|ps <service>`
# container -> 直接对容器名执行 `docker stop|restart <name>`
GUARDIAN_DOCKER_BACKEND=compose
GUARDIAN_DOCKER_PATH=docker

# --------------------------------------------------------------------- #
# 4. 时限
# --------------------------------------------------------------------- #
# 请求文件的最大年龄（秒），超过即拒绝（stale-request）。硬上限 120，防止
# 一个陈旧请求在很久以后突然把容器停掉。
GUARDIAN_MAX_AGE_SEC=120
# 单条 docker 命令的超时（秒）
GUARDIAN_CMD_TIMEOUT=120

# --------------------------------------------------------------------- #
# 5. 内核心跳守护（B16 §4）
# --------------------------------------------------------------------- #
# 容器无法可靠地重启自己，所以"内核卡死 → 重启内核容器"必须由宿主做。
# 与上面的睡眠流程共用同一条重启路径、同一把锁、同一个冷却。
GUARDIAN_KERNEL_GUARD=1
GUARDIAN_KERNEL_CONTAINER=guardian-kernel
GUARDIAN_KERNEL_HEARTBEAT_TIMEOUT=90
GUARDIAN_KERNEL_RESTART_COOLDOWN=300
# GUARDIAN_KERNEL_HEARTBEAT_FILE=
# GUARDIAN_KERNEL_RELOAD_REQUEST_FILE=
# GUARDIAN_KERNEL_STATE_FILE=
